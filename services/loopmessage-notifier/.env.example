# LoopMessage organization API key.
# Dashboard -> select org -> API -> Settings (enable the API feature first).
LOOPMESSAGE_API_KEY=""

# Sender to send from: the sender's NAME (e.g. "+19453926102"), not its id.
# The id from sender-name-list is rejected by the send endpoint (code 220).
# Omit for "auto". List senders: GET /health/upstream?token=<INTRO_WEBHOOK_TOKEN>
LOOPMESSAGE_SENDER_ID=""

# Shared secret the Masterinbox app must present as ?token=... — this
# endpoint sits on a public Railway domain, so without it anyone who guesses
# the URL can spend the LoopMessage balance. Also guards /contacts and
# /health/upstream.
INTRO_WEBHOOK_TOKEN=""

# Secret LoopMessage presents when it calls us with replies and delivery
# events. Paste the same value into the LoopMessage dashboard as the
# webhook's Authorization header. Required: without replies nobody is ever
# activated, so every alert would sit held until it expired.
LOOPMESSAGE_WEBHOOK_SECRET=""

# Which clients get notifications: client names or ids, comma-separated,
# case-insensitive. "*" = every client. Empty = nobody (fails closed).
#   NOTIFY_CLIENTS="Demo Portal"        # client-side test
#   NOTIFY_CLIENTS="*"                  # full rollout
NOTIFY_CLIENTS=""

# Test mode. When set, each enabled lead sends ONE text to this number
# instead of the client's team. Remove it to text real agents.
TEST_RECIPIENT_OVERRIDE=""

# Name used in the first message a team member gets. No emails, links,
# phone numbers or currencies (LoopMessage forbids them in a first message;
# the service refuses to start if it finds one).
WELCOME_BRAND="BrokerStaffer"

# --- LoopMessage pacing (defaults follow LoopMessage's published rules) ---

# Minutes between first messages to new numbers. LoopMessage requires 15.
INIT_INTERVAL_MINUTES="15"

# First messages per day. Unset = LoopMessage's warm-up (2/day for the first
# two days, rising to 50/day after three weeks). Set a number to override.
INIT_DAILY_CAP=""

# Seconds between alerts to people who haven't messaged in RECENT_INBOUND_HOURS.
# LoopMessage requires 120.
COLD_SEND_INTERVAL_SECONDS="120"
RECENT_INBOUND_HOURS="24"

# How long an alert waits for someone to reply to their welcome before it
# is dropped (it would be stale after that).
HOLD_TTL_HOURS="24"

# --- Rarely needed ---

# Force a delivery channel: imessage | sms | rcs | whatsapp.
# Leave unset so LoopMessage picks iMessage and falls back on its own.
LOOPMESSAGE_CHANNEL=""

# Country code assumed for bare local numbers in client_team_members.phone.
# The production rows are US.
DEFAULT_COUNTRY_CODE="1"

# Where state is saved. On Railway it defaults to the attached volume
# (RAILWAY_VOLUME_MOUNT_PATH); without a volume it resets on every deploy.
STATE_PATH=""

# Scheduler interval in seconds.
TICK_SECONDS="15"

# Override the LoopMessage API base (tests/staging).
LOOPMESSAGE_BASE_URL=""
